{
  "expo": {
    "name": "family-messenger",
    "slug": "family-messenger",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "가족 채팅 및 맞춤 포토북 제작을 위해 사진을 촬영하고 업로드합니다.",
        "NSPhotoLibraryUsageDescription": "가족 앨범과 포토북에 추억 사진을 등록하기 위해 갤러리에 접근합니다."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.yon_know.familymessenger"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "85837381-dbc6-4529-8709-1ada2e354174"
      }
    },
    "owner": "yon_know",
    "plugins": [
      "expo-status-bar",
      "expo-image"
    ]
  }
}
