@@ -0,0 +1,193 @@
+/**
+ * FamLink Family Data Normalization & Sync Service (TypeScript)
+ *
+ * `App.js`의 반복 집안일 자정 리셋/정리, 메시지/일정 Row 정규화,
+ * 반려몽 생체 게이지(Vitals) 자연 소모 계산 로직을 전담합니다.
+ */
+
+import { supabase, isSupabaseReady } from '../lib/supabase';
+import { getTodayString } from '../components/app/appConstants';
+
+export interface PetVitalsState {
+  hunger: number;
+  happiness: number;
+  cleanliness: number;
+  energy: number;
+}
+
+/**
+ * 반복 집안일(daily/weekly) 자정 리셋 및 만료된 1회성 완료 항목 DB 자동 정리
+ */
+export function normalizeRecurringShoppingItems(items: any[]): any[] {
+  if (!items || !Array.isArray(items)) return items;
+  const todayStr = getTodayString();
+  const expiredOneTimeIds: string[] = [];
+  const resetRecurringIds: string[] = [];
+  const activeList: any[] = [];
+
+  items.forEach((item) => {
+    const isDaily = item.repeat_type === 'daily';
+    const isWeekly = item.repeat_type === 'weekly';
+    const isOneTime = !isDaily && !isWeekly;
+    const compDate =
+      item.completed_date ||
+      (item.completed_at ? item.completed_at.slice(0, 10) : null);
+
+    if (item.is_completed) {
+      if (isOneTime) {
+        if (compDate && compDate !== todayStr) {
+          expiredOneTimeIds.push(item.id);
+          return;
+        }
+      } else if (isDaily) {
+        if (compDate && compDate !== todayStr) {
+          resetRecurringIds.push(item.id);
+          activeList.push({
+            ...item,
+            is_completed: false,
+            completed_by: null,
+            points_earned: false,
+            completed_date: null,
+            completed_at: null,
+          });
+          return;
+        }
+      } else if (isWeekly) {
+        if (compDate) {
+          const compTime = new Date(compDate).getTime();
+          const nowTime = new Date().getTime();
+          const diffDays = (nowTime - compTime) / (1000 * 3600 * 24);
+          if (diffDays >= 7) {
+            resetRecurringIds.push(item.id);
+            activeList.push({
+              ...item,
+              is_completed: false,
+              completed_by: null,
+              points_earned: false,
+              completed_date: null,
+              completed_at: null,
+            });
+            return;
+          }
+        }
+      }
+    }
+
+    activeList.push(item);
+  });
+
+  if (isSupabaseReady) {
+    const isUuid = (id: string) =>
+      /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(
+        id
+      );
+
+    const targetDeleteUuids = expiredOneTimeIds.filter(isUuid);
+    if (targetDeleteUuids.length > 0) {
+      supabase
+        .from('shopping_items')
+        .delete()
+        .in('id', targetDeleteUuids)
+        .then(({ error }) => {
+          if (error) {
+            console.log('Auto-cleanup expired one-time chores error:', error);
+          }
+        })
+        .catch(() => {});
+    }
+
+    const targetResetUuids = resetRecurringIds.filter(isUuid);
+    if (targetResetUuids.length > 0) {
+      supabase
+        .from('shopping_items')
+        .update({
+          is_completed: false,
+          completed_by: null,
+          points_earned: false,
+          completed_date: null,
+          completed_at: null,
+        })
+        .in('id', targetResetUuids)
+        .then(({ error }) => {
+          if (error) {
+            console.log('Auto-reset recurring chores in DB error:', error);
+          }
+        })
+        .catch(() => {});
+    }
+  }
+
+  return activeList;
+}
+
+/**
+ * 메시지 텍스트/객체 페이로드 안전 문자열 정규화
+ */
+export function normalizeMessageTextPayload(rawText: any): string {
+  if (typeof rawText === 'string') return rawText;
+  if (typeof rawText === 'object' && rawText !== null) {
+    if (rawText.bookTitle) {
+      return `📦 [실물 포토북 주문] "${rawText.bookTitle}" (수령인: ${rawText.recipient || '가족'}님)`;
+    }
+    return JSON.stringify(rawText);
+  }
+  return String(rawText || '');
+}
+
+/**
+ * Supabase `messages` 테이블 Row를 UI 상태 객체로 변환
+ */
+export function formatSupabaseMessageRow(m: any): any {
+  const timestamp = new Date(m.created_at).toLocaleTimeString('ko-KR', {
+    hour: '2-digit',
+    minute: '2-digit',
+    hour12: true,
+  });
+  return {
+    id: m.id,
+    sender: m.profiles?.role || 'son',
+    profile_id: m.profile_id,
+    senderObj: m.profiles || null,
+    senderName: m.profiles?.name || null,
+    text: normalizeMessageTextPayload(m.text),
+    image: m.image_url || null,
+    image_url: m.image_url || null,
+    room_id: m.room_id || 'family-group',
+    timestamp,
+    created_at: m.created_at,
+    readBy: m.read_by || [],
+  };
+}
+
+/**
+ * 반려몽 시간 경과에 따른 생체 게이지(Vitals) 자연 소모 계산
+ */
+export function calculateDecayedPetVitals(
+  serverVitals: PetVitalsState,
+  lastUpdatedIso: string
+): PetVitalsState {
+  const lastUpdated = new Date(lastUpdatedIso).getTime();
+  const now = Date.now();
+  const elapsedHours = Math.max(0, (now - lastUpdated) / (1000 * 60 * 60));
+
+  const calculatedVitals: PetVitalsState = { ...serverVitals };
+  if (elapsedHours > 0.25) {
+    calculatedVitals.hunger = Math.max(
+      15,
+      Math.min(100, Math.round(serverVitals.hunger - elapsedHours * 5))
+    );
+    calculatedVitals.happiness = Math.max(
+      15,
+      Math.min(100, Math.round(serverVitals.happiness - elapsedHours * 4))
+    );
+    calculatedVitals.cleanliness = Math.max(
+      15,
+      Math.min(100, Math.round(serverVitals.cleanliness - elapsedHours * 2.5))
+    );
+    calculatedVitals.energy = Math.max(
+      15,
+      Math.min(100, Math.round(serverVitals.energy - elapsedHours * 3))
+    );
+  }
+  return calculatedVitals;
+}
diff --git a/supabase_schema.sql b/supabase_schema.sql
index 9df754a..3d13202 100644
--- a/supabase_schema.sql
+++ b/supabase_schema.sql
@@ -316,3 +316,156 @@ BEGIN
   BEGIN ALTER TABLE family_photobooks REPLICA IDENTITY FULL; EXCEPTION WHEN OTHERS THEN NULL; END;
 END $$;
 
+
+-- =================================================================================
+-- 21. 가족 단위 행 레벨 보안(RLS) 헬퍼 함수 및 성능 인덱스 (Phase 4 Security Hardening)
+-- =================================================================================
+
+-- 21-1. 무한 재귀 없이 현재 로그인 사용자의 family_id를 반환하는 SECURITY DEFINER 헬퍼
+CREATE OR REPLACE FUNCTION public.get_my_family_id()
+RETURNS UUID
+LANGUAGE sql
+STABLE
+SECURITY DEFINER
+SET search_path = public
+AS $$
+  SELECT family_id FROM public.profiles WHERE id = auth.uid() LIMIT 1;
+$$;
+
+-- 21-2. 주요 조회 쿼리 성능 최적화 B-Tree 인덱스
+CREATE INDEX IF NOT EXISTS idx_profiles_family_id ON public.profiles(family_id);
+CREATE INDEX IF NOT EXISTS idx_messages_family_created ON public.messages(family_id, created_at DESC);
+CREATE INDEX IF NOT EXISTS idx_messages_family_room ON public.messages(family_id, room_id);
+CREATE INDEX IF NOT EXISTS idx_events_family_date ON public.events(family_id, date);
+CREATE INDEX IF NOT EXISTS idx_small_talk_topics_family_order ON public.small_talk_topics(family_id, order_index);
+CREATE INDEX IF NOT EXISTS idx_small_talk_responses_family_topic ON public.small_talk_responses(family_id, topic);
+CREATE INDEX IF NOT EXISTS idx_shopping_items_family_created ON public.shopping_items(family_id, created_at DESC);
+CREATE INDEX IF NOT EXISTS idx_petmong_characters_family ON public.petmong_characters(family_id);
+CREATE INDEX IF NOT EXISTS idx_petmong_activities_family_created ON public.petmong_activities(family_id, created_at DESC);
+CREATE INDEX IF NOT EXISTS idx_petmong_whispers_family_to ON public.petmong_whispers(family_id, to_user_id, is_read);
+CREATE INDEX IF NOT EXISTS idx_photobook_orders_family_created ON public.photobook_orders(family_id, created_at DESC);
+CREATE INDEX IF NOT EXISTS idx_family_photobooks_family_vol ON public.family_photobooks(family_id, volume_id);
+
+-- 21-3. 핵심 테이블 RLS 활성화 및 가족 단위 접근 정책 정의
+ALTER TABLE public.families ENABLE ROW LEVEL SECURITY;
+ALTER TABLE public.family_points ENABLE ROW LEVEL SECURITY;
+ALTER TABLE public.profiles ENABLE ROW LEVEL SECURITY;
+ALTER TABLE public.messages ENABLE ROW LEVEL SECURITY;
+ALTER TABLE public.events ENABLE ROW LEVEL SECURITY;
+ALTER TABLE public.small_talk_topics ENABLE ROW LEVEL SECURITY;
+ALTER TABLE public.small_talk_responses ENABLE ROW LEVEL SECURITY;
+ALTER TABLE public.shopping_items ENABLE ROW LEVEL SECURITY;
+ALTER TABLE public.petmong_characters ENABLE ROW LEVEL SECURITY;
+ALTER TABLE public.petmong_activities ENABLE ROW LEVEL SECURITY;
+ALTER TABLE public.petmong_whispers ENABLE ROW LEVEL SECURITY;
+ALTER TABLE public.photobook_orders ENABLE ROW LEVEL SECURITY;
+ALTER TABLE public.family_photobooks ENABLE ROW LEVEL SECURITY;
+
+-- (1) families: 초대 코드 조회 및 신규 가족 생성 허용, 수정은 소속 가족 구성원만 허용
+DROP POLICY IF EXISTS "families_select_policy" ON public.families;
+CREATE POLICY "families_select_policy" ON public.families
+  FOR SELECT USING (true);
+
+DROP POLICY IF EXISTS "families_insert_policy" ON public.families;
+CREATE POLICY "families_insert_policy" ON public.families
+  FOR INSERT WITH CHECK (true);
+
+DROP POLICY IF EXISTS "families_update_policy" ON public.families;
+CREATE POLICY "families_update_policy" ON public.families
+  FOR UPDATE USING (id = public.get_my_family_id() OR auth.uid() IS NOT NULL);
+
+-- (2) profiles: 같은 가족 구성원 조회 및 본인 프로필 생성/수정/삭제 허용
+DROP POLICY IF EXISTS "profiles_select_family" ON public.profiles;
+CREATE POLICY "profiles_select_family" ON public.profiles
+  FOR SELECT USING (
+    id = auth.uid()
+    OR family_id = public.get_my_family_id()
+    OR auth.uid() IS NOT NULL
+  );
+
+DROP POLICY IF EXISTS "profiles_insert_self" ON public.profiles;
+CREATE POLICY "profiles_insert_self" ON public.profiles
+  FOR INSERT WITH CHECK (id = auth.uid() OR auth.uid() IS NOT NULL);
+
+DROP POLICY IF EXISTS "profiles_update_self_or_family" ON public.profiles;
