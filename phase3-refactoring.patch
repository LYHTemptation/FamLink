-  if (!msgDate) {
-    return '대화 가능';
-  }
-
-  const now = new Date();
-  const isSameYear = msgDate.getFullYear() === now.getFullYear();
-  const isSameMonth = msgDate.getMonth() === now.getMonth();
-  const isSameDate = msgDate.getDate() === now.getDate();
-
-  // 1. 오늘: 시간 표시
